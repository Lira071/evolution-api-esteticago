# Referência das variáveis da Evolution API v2.
# No Render elas são definidas pelo render.yaml / aba Environment — este arquivo
# serve só para rodar local (docker run --env-file .env ...) e para consulta.

# URL pública do serviço (no Render: https://evolution-api-esteticago.onrender.com)
SERVER_URL=http://localhost:8080
SERVER_PORT=8080

# Chave global de API — enviada no header "apikey" em toda requisição.
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-aleatoria

# Banco (Prisma). Local: um Postgres qualquer. Render: injetado pelo render.yaml.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://user:pass@localhost:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_esteticago
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false

# Cache local (sem Redis)
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# Instância / QR
DEL_INSTANCE=false
QRCODE_LIMIT=30
CONFIG_SESSION_PHONE_CLIENT=EsteticaGo
CONFIG_SESSION_PHONE_NAME=Chrome
# CONFIG_SESSION_PHONE_VERSION=2.3000.1015901307   # descomente se der "versão desatualizada"

# Webhook global desligado (configure por instância)
WEBHOOK_GLOBAL_ENABLED=false

# Logs
LOG_LEVEL=ERROR
LOG_COLOR=false
TELEMETRY=false
TELEMETRY_ENABLED=false
